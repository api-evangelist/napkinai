        {
          "id": "e7de318a-1316-4376-b761-62a25b38a39b",
          "name": "Get visual request status",
          "request": {
            "name": "Get visual request status",
            "description": {
              "content": "Retrieve the current status and details of a visual request. Status is one of pending, completed, or failed. When completed, the response includes a generated_files array with download links and metadata. Status and file URLs expire 30 minutes after generation.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "visual",
                ":request-id",
                "status"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
